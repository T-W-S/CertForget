FROM node:22-alpine AS build

WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/db/package.json lib/db/package.json
COPY scripts/package.json scripts/package.json
COPY artifacts/certforge-t/package.json artifacts/certforge-t/package.json
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json tsconfig.json ./
COPY lib/api-client-react lib/api-client-react
COPY lib/api-spec lib/api-spec
COPY lib/api-zod lib/api-zod
COPY lib/db lib/db
COPY scripts scripts
COPY artifacts/certforge-t artifacts/certforge-t
ENV PORT=23403 BASE_PATH=/
RUN pnpm --filter @workspace/certforge-t run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY artifacts/certforge-t/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/artifacts/certforge-t/dist/public /usr/share/nginx/html
EXPOSE 8080
